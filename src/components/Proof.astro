---
// Figures as a spec sheet, then the client roster.
import LogoMarquee from './LogoMarquee.astro';
// Each figure counts up from zero when it scrolls into view; the + and % carry the brand spectrum.
const specs = [
  { pre: '', to: 28, dec: 0, unit: '', mark: '+', label: 'Years of IT experience' },
  { pre: '$', to: 5.5, dec: 1, unit: 'M', mark: '+', label: 'Of esports infrastructure deployed' },
  { pre: '', to: 750, dec: 0, unit: '', mark: '+', label: 'Students and players reached' },
  { pre: '', to: 100, dec: 0, unit: '', mark: '%', label: 'Of our business has come from word of mouth' },
];
const clients = [
  ['Longview ISD', 'longview', 40], ['Stafford MSD', 'stafford', 38], ['University of Houston', 'uh', 36],
  ['Pleasant Grove ISD', 'pleasantgrove', 40], ['Fort Bend ISD', 'fbisd', 50], ['University of St. Thomas', 'ust', 50],
  ['Alvin College', 'alvin', 46], ['Navarro College', 'navarro', 36], ['SAMSAT', 'samsat', 64],
  ['TexSEF', 'texsef', 60], ['City of Muskogee', 'muskogee', 44],
] as const;
const logos = clients.map(([name, key, h]) => ({ name, light: `/assets/clients/${key}-light.png`, dark: `/assets/clients/${key}-dark.png`, h }));
---
<section class="proof" aria-label="TANCHES.GG by the numbers">
  <div class="wrap">
    <dl class="specs">
      {specs.map((s) => (
        <div class="spec-cell" data-reveal>
          <dt class="lbl">{s.label}</dt>
          <dd class="v num">
            <span class="sr-only">{s.pre}{s.to.toFixed(s.dec)}{s.unit}{s.mark}</span>
            <span aria-hidden="true">{s.pre}<span class="count" data-to={s.to} data-dec={s.dec}><span class="ghost">{s.to.toFixed(s.dec)}</span><span class="n">{s.to.toFixed(s.dec)}</span></span>{s.unit}<span class="mark">{s.mark}</span></span>
          </dd>
        </div>
      ))}
    </dl>
  </div>
  <div class="trust">
    <p class="wrap trust-line">Trusted by schools, colleges, and organizations nationwide.</p>
    <LogoMarquee logos={logos} label="Clients" />
  </div>
</section>

<style>
  .proof { padding-block: clamp(1rem, 2vw, 2rem) clamp(1rem, 3vw, 2.5rem); }
  .specs { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); border-top: 1px solid var(--line-2); }
  .spec-cell { padding: 1.25rem 1.5rem 0 0; display: flex; flex-direction: column-reverse; justify-content: flex-end; gap: .5rem; }
  .spec-cell + .spec-cell { padding-left: 1.5rem; border-left: 1px solid var(--line); }
  .v { font-size: clamp(2rem, 1.4rem + 1.8vw, 3rem); font-weight: 380; letter-spacing: -0.035em; line-height: 1; }
  /* The number keeps its final width while it counts, so nothing beside it shifts */
  .count { display: inline-grid; justify-items: end; }
  .count > * { grid-area: 1 / 1; }
  .ghost { visibility: hidden; }
  .mark { font-weight: 720; margin-left: .02em; background: var(--spectrum); -webkit-background-clip: text; background-clip: text; color: transparent; }
  .lbl { color: var(--ink-2); font-size: var(--t-small); line-height: 1.4; max-width: 22ch; }
  .trust { margin-top: clamp(3.5rem, 5vw, 5rem); }
  .trust-line { color: var(--ink-2); font-size: var(--t-small); text-align: center; margin-bottom: 1.5rem; }
  @media (max-width: 760px) {
    .specs { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .spec-cell + .spec-cell:nth-child(3) { border-left: 0; padding-left: 0; }
    .spec-cell:nth-child(n+3) { border-top: 1px solid var(--line); margin-top: 1.25rem; }
  }
</style>

<script>
  // Count up once, when the figures come into view. Without motion (or JavaScript) the final numbers simply show.
  const counters = [...document.querySelectorAll<HTMLElement>('.proof .count')];
  const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (counters.length && !still && 'IntersectionObserver' in window) {
    const run = (el: HTMLElement, delay: number) => {
      const n = el.querySelector<HTMLElement>('.n')!;
      const to = Number(el.dataset.to), dec = Number(el.dataset.dec);
      const dur = 1600;
      let t0 = 0;
      const step = (t: number) => {
        if (!t0) t0 = t;
        const p = Math.min(1, Math.max(0, (t - t0 - delay) / dur));
        const e = 1 - Math.pow(1 - p, 4);
        n.textContent = (to * e).toFixed(dec);
        if (p < 1) requestAnimationFrame(step);
      };
      requestAnimationFrame(step);
    };
    counters.forEach((el) => { el.querySelector<HTMLElement>('.n')!.textContent = (0).toFixed(Number(el.dataset.dec)); });
    const io = new IntersectionObserver((entries) => {
      if (!entries.some((e) => e.isIntersecting)) return;
      io.disconnect();
      counters.forEach((el, i) => run(el, i * 120));
    }, { threshold: 0.4 });
    io.observe(document.querySelector('.proof .specs')!);
  }
</script>
