---
// The Technology hero object: the room render with every run drawn back to the network closet,
// frosted labels pinned to the real features, then the infrastructure in numbers.
// Wire and pin coordinates match the home Ecosystem's infrastructure layer (render pixels, 2048x1154).
interface Stat { value: string; number?: string; suffix?: string; label: string }
interface Props { stats: Stat[] }
const { stats } = Astro.props;

const labels = [
  { text: 'Secured network closet', x: 45, y: 24 },
  { text: 'Hardwired stations', x: 49, y: 45 },
  { text: 'Shoutcast rooms', x: 72, y: 28 },
  { text: 'Networked AV', x: 82, y: 56, left: true },
];
const wires = [
  ['M922 277 Q855 368 788 577', 1], ['M922 277 Q963 352 1004 519', 1],
  ['M922 277 Q548 292 174 600', 2], ['M922 277 Q1290 308 1659 635', 2],
  ['M922 277 Q1198 200 1475 323', 3], ['M922 277 Q1280 241 1638 473', 3],
  ['M922 277 Q676 314 430 554', 2], ['M922 277 Q1024 386 1126 646', 2],
  ['M922 277 Q560 315 197 428', 2], ['M922 277 Q527 430 131 890', 2],
  ['M922 277 Q947 446 971 953', 2], ['M922 277 Q1062 431 1202 891', 2],
] as const;
---
<figure class="plan">
  <div class="obj">
    <img class="room object" src="/assets/opt/home-overhead-network.webp" width="2048" height="1154"
      alt="Overhead design render of an esports room wired back to one network closet" fetchpriority="high" />
    <svg class="wires" viewBox="0 0 2048 1154" preserveAspectRatio="none" aria-hidden="true">
      <defs>
        <linearGradient id="tp-wire" x1="0" x2="1" y1="0" y2="0">
          <stop offset="0" stop-color="#F53F1D" /><stop offset=".5" stop-color="#DA358B" /><stop offset="1" stop-color="#C92FD1" />
        </linearGradient>
        <radialGradient id="tp-hub"><stop offset="0" stop-color="#E23869" stop-opacity=".55" /><stop offset="1" stop-color="#E23869" stop-opacity="0" /></radialGradient>
      </defs>
      <circle cx="922" cy="277" r="150" fill="url(#tp-hub)" class="hub" />
      {wires.map(([d, g], i) => <path d={d} class="wire" pathLength="1" style={`--d:${g * 140 + i * 40}ms`} />)}
      <circle cx="922" cy="277" r="14" class="core" />
    </svg>
    <ul class="labels" role="list" aria-label="Infrastructure in this room">
      {labels.map((l, i) => (
        <li class:list={['label-glass', { left: l.left }]} style={`--x:${l.x}%;--y:${l.y}%;--i:${i}`}><span class="dot" aria-hidden="true"></span>{l.text}</li>
      ))}
    </ul>
  </div>
</figure>

<dl class="figs" aria-label="The infrastructure in numbers">
  {stats.map((s) => (
    <div>
      <dt>{s.label}</dt>
      <dd class="num">{s.value}</dd>
    </div>
  ))}
</dl>

<style>
  .plan { width: min(1180px, 94vw); margin: clamp(2rem, 4vw, 3.5rem) auto 0; }
  .obj { position: relative; }
  .room { width: 100%; height: auto; }
  .wires { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; }
  .wire { fill: none; stroke: url(#tp-wire); stroke-width: 5; stroke-linecap: round; stroke-dasharray: 1; stroke-dashoffset: 0; opacity: .9; }
  .core { fill: #E23869; stroke: #FFFFFF; stroke-width: 4; }
  .labels { list-style: none; padding: 0; margin: 0; position: absolute; inset: 0; }
  .labels li { position: absolute; left: var(--x); top: var(--y); translate: -1.125rem -50%; }
  .labels li.left { flex-direction: row-reverse; padding: .45rem .5rem .45rem .9rem; translate: calc(-100% + 1.125rem) -50%; }
  @media (prefers-reduced-motion: no-preference) {
    .obj { animation: rise 1.4s var(--ease-out) both .1s; }
    .wire { animation: draw 1.6s var(--ease-out) both; animation-delay: calc(.8s + var(--d)); }
    .hub { animation: glow 3.2s ease-in-out infinite 2.4s; transform-origin: 922px 277px; }
    .labels li { animation: pop .9s var(--ease-out) both; animation-delay: calc(1.6s + var(--i) * 140ms); }
  }
  @keyframes rise { from { opacity: 0; transform: translateY(32px) scale(.98); filter: blur(6px); } }
  @keyframes draw { from { stroke-dashoffset: 1; } }
  @keyframes glow { 50% { opacity: .45; } }
  @keyframes pop { from { opacity: 0; transform: translateY(8px) scale(.94); } }

  .figs { width: min(100% - 2 * var(--gutter), var(--max)); margin: clamp(2.5rem, 5vw, 4rem) auto 0; text-align: left; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); }
  .figs div { display: flex; flex-direction: column-reverse; justify-content: flex-end; gap: .5rem; padding: 1.25rem clamp(1rem, 2vw, 1.75rem) 0; border-top: 1px solid var(--line-2); position: relative; }
  .figs div:first-child { padding-left: 0; }
  .figs div + div { border-left: 1px solid var(--line); }
  .figs div::before { content: ''; position: absolute; top: -1px; left: 0; width: 2rem; height: 2px; background: var(--spectrum); }
  .figs div + div::before { left: clamp(1rem, 2vw, 1.75rem); }
  .figs dd { font-size: clamp(2.5rem, 1.8rem + 2.2vw, 3.75rem); font-weight: 300; letter-spacing: -0.045em; line-height: 1; }
  .figs dt { font-size: var(--t-small); color: var(--ink-2); max-width: 24ch; }

  @media (max-width: 760px) {
    .plan { width: 118vw; margin-left: -9vw; }
    .labels li { font-size: .75rem; }
    .labels li:nth-child(n+3) { display: none; }
    .figs { grid-template-columns: 1fr 1fr; row-gap: 1.75rem; }
    .figs div + div:nth-child(3) { padding-left: 0; border-left: 0; }
    .figs div + div:nth-child(3)::before { left: 0; }
  }
</style>
