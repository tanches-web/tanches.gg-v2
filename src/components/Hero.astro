---
// Homepage hero: the tagline over a full-screen stage that cycles three completed labs.
// Lab data, and how to add video later, live in src/lib/showcase.ts.
import { Picture } from 'astro:assets';
import Icon from './Icon.astro';
import { LABS } from '../lib/showcase';

const isFile = (u?: string) => !!u && /\.(mp4|webm)(\?.*)?$/i.test(u);
const hasFilmFile = LABS.some((l) => isFile(l.film));
---
<section class="hero" aria-labelledby="hero-title" data-showcase style={`--ha:${LABS[0].colors[0]};--hb:${LABS[0].colors[1]}`}>
  <div class="stage" data-nav-tone="dark">
    <div class="reel">
      {LABS.map((lab, li) => (
        <div class:list={['slide', { on: li === 0 }]} data-slide data-seconds={lab.seconds ?? 10} data-a={lab.colors[0]} data-b={lab.colors[1]} inert={li !== 0}>
          {lab.shots.map((s, si) => (
            <Picture
              src={s.src}
              formats={['avif', 'webp']}
              widths={[768, 1280, 1920]}
              sizes="100vw"
              alt={s.alt}
              class={`shot${si === 0 ? ' on' : ''}`}
              style={`--pos:${s.pos ?? '50% 50%'};--pos-m:${s.posMobile ?? s.pos ?? '50% 50%'}`}
              loading="eager"
              fetchpriority={li === 0 && si === 0 ? 'high' : 'low'}
              decoding="async"
              data-shot
            />
          ))}
          {lab.loop && <video class="loop" muted loop playsinline preload="none" data-loop={lab.loop} aria-hidden="true" tabindex="-1"></video>}
        </div>
      ))}
    </div>
    <div class="scrim" aria-hidden="true"></div>

    <div class="inner">
      <div class="copy">
        <h1 id="hero-title">
          <span class="l1">Not just equipment.</span>
          <strong class="l2 spectrum-text">We build esports ecosystems.</strong>
        </h1>
        <p class="lede">We design the room, wire the network, install the hardware, and support it every season after. Behind every build is TanChes Global, a Houston IT firm that has worked with schools, cities, and businesses for 28 years.</p>
        <div class="ctas">
          <a class="btn btn-primary" href="/Contact">Book a free consultation <Icon name="arrow-right" /></a>
          <a class="btn btn-ghost" href="/Assessment">Take the 4-minute assessment</a>
        </div>
      </div>

      <div class="caps">
        {LABS.map((lab, li) => (
          <div class="cap" id={`lab-${lab.id}`} role="tabpanel" aria-labelledby={`labtab-${lab.id}`} hidden={li !== 0} data-cap>
            <div class="pictured">
              <img class="plogo" src={lab.logo} alt={lab.org} loading="lazy" decoding="async" />
              <figure class="pline">
                <blockquote><p>“{lab.quote.text}”</p></blockquote>
                <figcaption><span class="qname">{lab.quote.name}</span>, {lab.quote.role}</figcaption>
              </figure>
              <a class="go" href={lab.href}>See the build<span class="sr-only">: {lab.org}</span> <Icon name="arrow-right" size={16} /></a>
            </div>
            {lab.film && (isFile(lab.film)
              ? <button class="watch" type="button" data-film={lab.film}><Icon name="play" size={16} />Watch the film</button>
              : <a class="watch" href={lab.film} target="_blank" rel="noopener"><Icon name="play" size={16} />Watch the film<span class="sr-only"> (opens in a new tab)</span></a>
            )}
          </div>
        ))}
      </div>

      <div class="dock">
        <button class="rot" type="button" data-rotation aria-label="Pause the lab showcase">
          <Icon name="pause" size={18} class="i-pause" />
          <Icon name="play" size={18} class="i-play" />
        </button>
        <div class="tabs" role="tablist" aria-label="Completed labs">
          {LABS.map((lab, li) => (
            <button
              type="button"
              role="tab"
              id={`labtab-${lab.id}`}
              aria-controls={`lab-${lab.id}`}
              aria-selected={li === 0 ? 'true' : 'false'}
tabindex={li === 0 ? 0 : -1}
              aria-label={`${lab.org}, ${lab.meta}`}
              style={`--t1:${lab.colors[0]};--t2:${lab.colors[1]}`}
            >
              <span class="t-name">{lab.org}</span>
              <span class="t-short">{lab.short}</span>
              <span class="t-colors" style={`--d1:${lab.palette.dots[0]};--d2:${lab.palette.dots[1]}`}><span class="dots" aria-hidden="true"><i></i><i></i></span><span class="c-name">{lab.palette.name}</span></span>
              <span class="t-meta spec">{lab.meta}</span>
              <span class="bar" aria-hidden="true"><i></i></span>
            </button>
          ))}
        </div>
      </div>
    </div>
  </div>

  <p class="lede lede-out">We design the room, wire the network, install the hardware, and support it every season after. Behind every build is TanChes Global, a Houston IT firm that has worked with schools, cities, and businesses for 28 years.</p>

  {hasFilmFile && (
    <dialog class="film" data-film-dialog aria-label="Case study film">
      <form method="dialog"><button class="film-close" aria-label="Close the film"><Icon name="x" /></button></form>
      <video controls playsinline preload="none"></video>
    </dialog>
  )}
</section>

<style>
  /* Registered so the stage can cross-fade between client colours */
  @property --ha { syntax: '<color>'; inherits: true; initial-value: #E23869; }
  @property --hb { syntax: '<color>'; inherits: true; initial-value: #C92FD1; }

  .hero { padding: .75rem .75rem clamp(2.5rem, 5vw, 4.5rem); transition: --ha 1.4s var(--ease-out), --hb 1.4s var(--ease-out); }
  .stage {
    position: relative; isolation: isolate; overflow: hidden; max-width: 112rem; margin-inline: auto;
    height: max(40rem, min(100svh - 1.5rem, 58.75rem)); border-radius: 28px;
    background: #0B0C10; color: #F4F5F7;
    box-shadow: 0 70px 90px -64px color-mix(in srgb, var(--ha) 80%, transparent), 0 34px 60px -44px rgba(14, 16, 22, .55);
  }

  /* Reel: each lab is a slide; each slide cuts between its shots */
  .reel, .slide { position: absolute; inset: 0; }
  .slide { opacity: 0; z-index: 0; }
  .slide.was { opacity: 1; z-index: 1; }
  .slide.on { opacity: 1; z-index: 2; transition: opacity 1.3s var(--ease-out); }
  .slide :global(img.shot), .slide .loop { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: var(--pos, 50% 50%); }
  .slide :global(img.shot) { opacity: 0; z-index: 0; }
  .slide :global(img.shot.was) { opacity: 1; z-index: 1; }
  .slide :global(img.shot.on) { opacity: 1; z-index: 2; transition: opacity 1.3s var(--ease-out); }
  .slide .loop { z-index: 3; opacity: 0; transition: opacity .8s var(--ease-out); }
  .slide .loop.ready { opacity: 1; }
  @media (prefers-reduced-motion: no-preference) {
    .slide.on :global(img.shot.on), .slide.on :global(img.shot.was), .slide.was :global(img.shot.on), .slide.was :global(img.shot.was) { animation: push 14s linear both; }
    .stage.paused :global(img.shot) { animation-play-state: paused; }
  }
  @keyframes push { from { transform: scale(1.02); } to { transform: scale(1.1); } }

  /* Scrim: dark on the left for the headline and along the bottom for the dock; the room stays clear on the right */
  .scrim {
    position: absolute; inset: 0; z-index: 4; pointer-events: none;
    background:
      radial-gradient(60% 80% at 0% 100%, color-mix(in srgb, var(--ha) 26%, transparent), transparent 70%),
      linear-gradient(90deg, rgba(8, 9, 12, .95) 0%, rgba(8, 9, 12, .93) 36%, rgba(8, 9, 12, .86) 50%, rgba(8, 9, 12, .46) 63%, rgba(8, 9, 12, .12) 76%, rgba(8, 9, 12, 0) 86%),
      linear-gradient(0deg, rgba(8, 9, 12, .9) 0%, rgba(8, 9, 12, .4) 20%, rgba(8, 9, 12, 0) 40%),
      linear-gradient(180deg, rgba(8, 9, 12, .5) 0%, rgba(8, 9, 12, 0) 20%);
  }

  .inner {
    position: absolute; inset: 0; z-index: 5; display: grid; grid-template-columns: minmax(0, 1fr) auto; grid-template-rows: minmax(0, 1fr) auto;
    gap: 1.25rem 2rem; align-items: end;
    padding: 5.75rem max(1.25rem, calc(var(--gutter) - .75rem), calc((100% - var(--max)) / 2)) clamp(.875rem, 1.4vw, 1.25rem);
  }
  .copy { position: relative; grid-column: 1; grid-row: 1; max-width: 47rem; padding-bottom: .5rem; }
  /* A pool of shade that follows the words, so the tagline keeps its contrast over any photo */
  .copy::before { content: ''; position: absolute; z-index: -1; inset: -5rem -6rem -3rem -10rem; pointer-events: none; background: radial-gradient(closest-side, rgba(8, 9, 12, .78), rgba(8, 9, 12, .5) 62%, rgba(8, 9, 12, 0)); }
  h1 { display: grid; gap: .04em; font-size: clamp(2.125rem, min(.9rem + 4.7vw, 11.5svh), 5.25rem); line-height: .98; letter-spacing: -0.04em; text-wrap: balance; }
  .l1 { font-weight: 330; }
  .l2 { font-weight: 720; padding-bottom: .08em; filter: drop-shadow(0 0 26px rgba(8, 9, 12, .85)); }
  .lede { margin-top: 1.25rem; max-width: 42rem; font-size: clamp(1rem, .95rem + .3vw, 1.1875rem); line-height: 1.5; color: rgba(244, 245, 247, .86); }
  .lede-out { display: none; }
  .ctas { display: flex; flex-wrap: wrap; gap: .75rem; margin-top: 1.75rem; }
  .stage .btn-primary { background: #F4F5F7; color: #0E1016; box-shadow: 0 14px 30px -14px rgba(0, 0, 0, .7); }
  .stage .btn-ghost { background: rgba(255, 255, 255, .1); color: #fff; border-color: rgba(255, 255, 255, .36); }
  .stage .btn-ghost:hover { background: rgba(255, 255, 255, .2); border-color: rgba(255, 255, 255, .65); }
  .stage :focus-visible { outline-color: #fff; }

  /* Caption for the lab on screen */
  .caps { grid-column: 2; grid-row: 1; padding-bottom: .5rem; }
  .cap { display: grid; gap: .6rem; justify-items: start; width: 23rem; }
  .cap[hidden] { display: none; }
  .pictured, .watch {
    background: rgba(14, 16, 22, .66); border: 1px solid rgba(255, 255, 255, .16); color: #fff; text-decoration: none;
    backdrop-filter: blur(20px) saturate(1.4); -webkit-backdrop-filter: blur(20px) saturate(1.4);
    transition: background-color .25s, border-color .25s;
  }
  .pictured { position: relative; display: grid; gap: .7rem; justify-items: start; width: 100%; padding: 1.1rem 1.2rem 1.15rem; border-radius: 20px; }
  .pictured .go { text-decoration: none; color: #fff; white-space: nowrap; }
  .pictured .go::after { content: ''; position: absolute; inset: 0; border-radius: inherit; }
  .pictured .go:focus-visible { outline: none; }
  .pictured:has(.go:focus-visible) { outline: 2px solid #fff; outline-offset: 3px; }
  .pline blockquote { font-size: 1rem; line-height: 1.45; color: #F4F5F7; font-weight: 500; letter-spacing: -0.005em; }
  .pline figcaption { margin-top: .45rem; font-size: .8125rem; color: rgba(244, 245, 247, .72); }
  .qname { color: #F4F5F7; font-weight: 640; }
  .pictured:hover, .watch:hover { background: rgba(14, 16, 22, .8); border-color: rgba(255, 255, 255, .4); }
  .plogo { height: 2.25rem; width: auto; max-width: 13rem; object-fit: contain; object-position: left center; }

  .go { display: inline-flex; align-items: center; gap: .4rem; font-weight: 640; font-size: .9375rem; }
  .go :global(svg) { transition: transform .35s var(--ease-out); }
  .pictured:hover .go :global(svg) { transform: translateX(3px); }
  .watch { display: inline-flex; align-items: center; gap: .5rem; min-height: 2.75rem; padding: 0 1.1rem; border-radius: 999px; font-weight: 640; font-size: .9375rem; }
  @media (prefers-reduced-motion: no-preference) {
    .cap:not([hidden]) { animation: cap-in .8s var(--ease-out) both; }
  }
  @keyframes cap-in { from { opacity: 0; transform: translateY(10px); filter: blur(6px); } }

  /* Dock: one tab per lab, with its time on screen filling in the client's colours */
  .dock {
    grid-column: 1 / -1; grid-row: 2; display: grid; grid-template-columns: minmax(0, 1fr) auto; align-items: center; gap: .5rem;
    padding: .4rem; border-radius: 22px; background: rgba(14, 16, 22, .52); border: 1px solid rgba(255, 255, 255, .14);
    backdrop-filter: blur(22px) saturate(1.5); -webkit-backdrop-filter: blur(22px) saturate(1.5);
  }
  :global(html:not(.js)) .dock { display: none; }
  .tabs { grid-column: 1; grid-row: 1; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: .25rem; }
  .tabs button { display: grid; gap: .15rem; text-align: left; padding: .65rem 1rem .8rem; border-radius: 16px; color: rgba(244, 245, 247, .66); transition: background-color .25s, color .25s; }
  .tabs button:hover { background: rgba(255, 255, 255, .07); color: #fff; }
  .tabs button[aria-selected='true'] { background: rgba(255, 255, 255, .1); color: #fff; }
  .t-meta { color: inherit; opacity: .82; font-size: .6875rem; }
  .t-name, .t-short { font-weight: 640; font-size: 1rem; letter-spacing: -0.01em; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .t-short { display: none; }
  /* The client's colours, as on its case study: two overlapping dots and their name */
  .t-colors { display: flex; align-items: center; gap: .5rem; min-width: 0; margin-block: .2rem .1rem; font-size: .8125rem; font-weight: 560; }
  .c-name { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .dots { display: inline-flex; flex: none; }
  .dots i { width: .875rem; height: .875rem; border-radius: 50%; background: var(--d1); box-shadow: 0 0 0 1.5px rgba(255, 255, 255, .85); }
  .dots i + i { margin-left: -.3rem; background: var(--d2); }
  .bar { display: block; height: 3px; margin-top: .55rem; border-radius: 3px; background: rgba(255, 255, 255, .2); overflow: hidden; }
  .bar i { display: block; height: 100%; border-radius: 3px; background: linear-gradient(90deg, var(--t1), var(--t2)); transform-origin: left; transform: scaleX(var(--p, 0)); }
  .rot { grid-column: 2; grid-row: 1; width: 3rem; height: 3rem; margin-right: .35rem; border-radius: 50%; display: grid; place-items: center; color: #fff; border: 1px solid rgba(255, 255, 255, .24); transition: background-color .25s; }
  .rot:hover { background: rgba(255, 255, 255, .12); }
  .rot :global(.i-play) { display: none; }
  .stage.paused .rot :global(.i-play) { display: block; }
  .stage.paused .rot :global(.i-pause) { display: none; }

  /* Film player */
  .film { width: min(72rem, 94vw); padding: 0; border: 0; border-radius: 22px; overflow: hidden; background: #000; }
  .film::backdrop { background: rgba(8, 9, 12, .82); backdrop-filter: blur(10px); }
  .film video { display: block; width: 100%; aspect-ratio: 16 / 9; background: #000; }
  .film-close { position: absolute; top: .75rem; right: .75rem; z-index: 2; width: 2.75rem; height: 2.75rem; border-radius: 50%; display: grid; place-items: center; background: rgba(14, 16, 22, .6); color: #fff; border: 1px solid rgba(255, 255, 255, .3); }

  /* One authored entrance: the stage opens, then the words and the dock arrive */
  @media (prefers-reduced-motion: no-preference) {
    .stage { animation: open 1.3s var(--ease-out) both; }
    .copy > *, .caps, .dock { animation: arrive 1.1s var(--ease-out) both; }
    .copy > :nth-child(1) { animation-delay: .25s; }
    .copy > :nth-child(2) { animation-delay: .38s; }
    .copy > :nth-child(3) { animation-delay: .5s; }
    .caps { animation-delay: .7s; }
    .dock { animation-delay: .82s; }
  }
  @keyframes open { from { opacity: 0; clip-path: inset(3% 3% 6% 3% round 40px); } to { opacity: 1; clip-path: inset(0 round 28px); } }
  @keyframes arrive { from { opacity: 0; transform: translateY(22px); filter: blur(8px); } }

  @media (max-width: 1100px) {
    .cap { width: 19rem; }
    .pictured { gap: .55rem; padding: .85rem 1rem .9rem; border-radius: 18px; }
    .plogo { height: 1.6rem; max-width: 9rem; }
    .pline blockquote { font-size: .9375rem; }
    .pline figcaption { margin-top: .3rem; font-size: .75rem; }
  }
  @media (max-width: 860px) {
    /* Phones: logo and link share a row, the quote runs full width beneath */
    .cap { width: auto; }
    .pictured { grid-template-columns: auto auto; justify-content: space-between; align-items: center; column-gap: 1rem; }
    .pline { grid-column: 1 / -1; grid-row: 2; }
    .go { grid-column: 2; grid-row: 1; }
  }
  @media (max-width: 860px) {
    .hero { padding: .5rem .5rem 2.5rem; }
    .stage { height: max(39rem, min(100svh - 1rem, 50rem)); border-radius: 22px; }
    .scrim {
      background:
        radial-gradient(90% 60% at 0% 100%, color-mix(in srgb, var(--ha) 24%, transparent), transparent 70%),
        linear-gradient(0deg, rgba(8, 9, 12, .96) 0%, rgba(8, 9, 12, .93) 46%, rgba(8, 9, 12, .72) 60%, rgba(8, 9, 12, .1) 80%, rgba(8, 9, 12, .38) 100%);
    }
    .slide :global(img.shot), .slide .loop { object-position: var(--pos-m, 50% 50%); }
    .inner { grid-template-columns: minmax(0, 1fr); grid-template-rows: minmax(0, 1fr) auto auto; gap: .875rem; padding: 5.25rem 1rem .75rem; }
    .caps { grid-column: 1; grid-row: 2; padding-bottom: 0; }
    .dock { grid-row: 3; }
    h1 { font-size: clamp(2.125rem, 9.4vw, 3.25rem); }
    .lede { font-size: 1rem; margin-top: 1rem; }
    .ctas { margin-top: 1.25rem; gap: .5rem 1.25rem; align-items: center; }
    .ctas .btn-ghost { background: none; border: 0; min-height: 2.75rem; padding: 0; backdrop-filter: none; text-decoration: underline; text-underline-offset: .25em; font-weight: 600; }
    .ctas .btn-ghost:hover { background: none; }
  }
  @media (max-width: 560px) {
    /* Phones: the lede moves below the stage so the room keeps the top half of the screen */
    .copy .lede { display: none; }
    .lede-out { display: block; max-width: none; margin: 0; padding: 1.5rem .5rem 0; color: var(--ink-2); font-size: 1.0625rem; }
    .ctas .btn-primary { width: 100%; }
    .t-meta, .t-name, .c-name { display: none; }
    .t-short { display: block; font-size: .8125rem; }
    .t-colors { margin: .3rem 0 0; }
    .dots i { width: .75rem; height: .75rem; }
    .tabs button { padding: .6rem .55rem .7rem; }
    .rot { width: 2.75rem; height: 2.75rem; margin-right: .2rem; }
  }
  @media (max-width: 380px) {
    .t-short { font-size: .75rem; }
    .tabs button { padding-inline: .4rem; }
  }
</style>

<script>
  const root = document.querySelector<HTMLElement>('[data-showcase]');
  if (root) {
    const stage = root.querySelector<HTMLElement>('.stage')!;
    const slides = [...root.querySelectorAll<HTMLElement>('[data-slide]')];
    const caps = [...root.querySelectorAll<HTMLElement>('[data-cap]')];
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const rot = root.querySelector<HTMLButtonElement>('[data-rotation]')!;
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const shotsOf = (i: number) => [...slides[i].querySelectorAll<HTMLElement>('[data-shot]')];
    const duration = (i: number) => Number(slides[i].dataset.seconds || 10) * 1000;

    let lab = 0, shot = 0, elapsed = 0, last = performance.now();
    let userPaused = reduce;      // visitors who ask for less motion start paused
    let hold = false;             // pointer over the controls, or keyboard focus inside the stage
    let visible = true;

    // Swap which element is `on`; the previous one stays underneath as `was` until the cross-fade ends.
    const swap = (els: HTMLElement[], next: number) => {
      els.forEach((el, i) => {
        if (i === next) { el.classList.remove('was'); el.classList.add('on'); }
        else if (el.classList.contains('on')) {
          el.classList.remove('on'); el.classList.add('was');
          setTimeout(() => el.classList.remove('was'), 1400);
        }
      });
    };

    const rewind = (i: number) => shotsOf(i).forEach((el, si) => { el.classList.remove('was'); el.classList.toggle('on', si === 0); });

    const playLoop = (i: number) => {
      slides.forEach((s, si) => {
        const v = s.querySelector<HTMLVideoElement>('video.loop');
        if (!v) return;
        if (si === i && !reduce && !userPaused) {
          if (!v.src) { v.src = v.dataset.loop!; v.addEventListener('playing', () => v.classList.add('ready'), { once: true }); }
          v.play().catch(() => {});
        } else v.pause();
      });
    };

    const show = (i: number, focus = false) => {
      const next = (i + slides.length) % slides.length;
      if (next !== lab) {
        const prev = lab;
        swap(slides, next);
        slides.forEach((s, si) => { s.inert = si !== next; });
        caps.forEach((c, ci) => { c.hidden = ci !== next; });
        setTimeout(() => { if (lab !== prev) rewind(prev); }, 1500);
      }
      lab = next; shot = 0; elapsed = 0;
      tabs.forEach((t, ti) => {
        const on = ti === lab;
        t.setAttribute('aria-selected', String(on));
        t.tabIndex = on ? 0 : -1;
        t.style.setProperty('--p', on && userPaused ? '1' : '0');
      });
      root.style.setProperty('--ha', slides[lab].dataset.a!);
      root.style.setProperty('--hb', slides[lab].dataset.b!);
      playLoop(lab);
      if (focus) tabs[lab].focus();
    };

    const setPaused = (on: boolean) => {
      userPaused = on;
      stage.classList.toggle('paused', on);
      rot.setAttribute('aria-label', on ? 'Play the lab showcase' : 'Pause the lab showcase');
      tabs[lab].style.setProperty('--p', on ? '1' : (elapsed / duration(lab)).toFixed(4));
      playLoop(lab);
    };

    const tick = (now: number) => {
      requestAnimationFrame(tick);
      const dt = Math.min(now - last, 120);
      last = now;
      if (userPaused || hold || !visible || document.hidden) return;
      elapsed += dt;
      const d = duration(lab);
      const shots = shotsOf(lab);
      const want = Math.min(shots.length - 1, Math.floor((elapsed / d) * shots.length));
      if (want !== shot) { shot = want; swap(shots, shot); }
      tabs[lab].style.setProperty('--p', Math.min(1, elapsed / d).toFixed(4));
      if (elapsed >= d) show(lab + 1);
    };

    tabs.forEach((t, i) => {
      t.addEventListener('click', () => show(i));
      t.addEventListener('keydown', (e) => {
        const k = e.key;
        if (k === 'ArrowRight' || k === 'ArrowLeft' || k === 'Home' || k === 'End') {
          e.preventDefault();
          show(k === 'Home' ? 0 : k === 'End' ? tabs.length - 1 : i + (k === 'ArrowRight' ? 1 : -1), true);
        }
      });
    });
    rot.addEventListener('click', () => setPaused(!userPaused));

    // Hold while the pointer is on the controls or the keyboard is inside the stage.
    root.querySelectorAll<HTMLElement>('.dock, .caps').forEach((el) => {
      el.addEventListener('pointerenter', (e) => { if (e.pointerType === 'mouse') hold = true; });
      el.addEventListener('pointerleave', () => { hold = stage.matches(':focus-within'); });
    });
    stage.addEventListener('focusin', () => { hold = true; });
    stage.addEventListener('focusout', () => { requestAnimationFrame(() => { if (!stage.matches(':focus-within')) hold = false; }); });
    if ('IntersectionObserver' in window) new IntersectionObserver(([e]) => { visible = e.isIntersecting; }, { threshold: 0.15 }).observe(stage);

    // Case-study film player (only present once a lab has an .mp4 or .webm film).
    const dialog = root.querySelector<HTMLDialogElement>('[data-film-dialog]');
    if (dialog) {
      const video = dialog.querySelector('video')!;
      let resume = false;
      root.querySelectorAll<HTMLButtonElement>('button[data-film]').forEach((b) => b.addEventListener('click', () => {
        resume = !userPaused;
        setPaused(true);
        video.src = b.dataset.film!;
        dialog.showModal();
        video.play().catch(() => {});
      }));
      dialog.addEventListener('close', () => { video.pause(); video.removeAttribute('src'); video.load(); if (resume) setPaused(false); });
      dialog.addEventListener('click', (e) => { if (e.target === dialog) dialog.close(); });
    }

    if (reduce) { stage.classList.add('paused'); rot.setAttribute('aria-label', 'Play the lab showcase'); tabs[0].style.setProperty('--p', '1'); }
    // Deep link: /?lab=alvin opens on that lab.
    const want = new URLSearchParams(location.search).get('lab');
    const wi = tabs.findIndex((t) => t.id === 'labtab-' + want);
    if (wi > 0) show(wi);
    playLoop(lab);
    requestAnimationFrame(tick);
  }
</script>
