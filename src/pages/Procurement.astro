---
// Procurement: make buying feel easy. Contracts, the IDs a business office asks for, grants,
// leasing, and questions, each answered in plain, scannable structure.
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import SectionHead from '../components/SectionHead.astro';
import Faq from '../components/Faq.astro';
import ProjectCTA from '../components/ProjectCTA.astro';
import Icon from '../components/Icon.astro';
import IdSheet from '../components/procurement/IdSheet.astro';
import page from '../content/pages/Procurement.json';
import { splitHeading, asset } from '../components/solution/heading';

const sec = (id: string) => page.sections.find((s: any) => s.id === id) as any;
const seo = {
  title: page.seo.title,
  description: page.seo.description,
  canonical: page.seo.canonical,
  ogImage: '/assets/og-logo.png',
  jsonLd: page.seo.jsonLd,
};

const hero = sec('proc-head');
const hh = splitHeading(hero);
const heroImg = hero.images[0];
const toc = hero.lists[0];

const ct = sec('contracts');
const office = sec('office');
const grants = sec('grants');
const gh = splitHeading(grants);
const gImg = grants.images[0];
const gc = grants.clientColors;
const [askCta, picturedCta] = grants.ctas;
const leasing = sec('leasing');
const lease = leasing.interactive;
const noteBase = lease.note.slice(0, lease.note.lastIndexOf('·') + 1);
const faq = sec('questions');
const assess = faq.cards[0];
const strip = (s: string) => s.replace(/\s*↗\s*$/, '');
---
<Base seo={seo}>
  <PageHero
    title={hh.title}
    strong={hh.strong}
    lede={hero.lede}
    ctas={hero.ctas.map((c: any) => ({ label: c.label, href: c.href, primary: c.style === 'primary' }))}
  >
    <figure class="h-fig" style={`--ca:${heroImg.clientColors.a};--cb:${heroImg.clientColors.b}`}>
      <div class="photo plate"><img src={asset(heroImg.src)} alt={heroImg.alt} fetchpriority="high" /></div>
      <a class="label-glass chip" href={heroImg.chip.href}><span class="dots" aria-hidden="true"><i></i><i></i></span>{heroImg.chip.label}<Icon name="arrow-right" size={16} /></a>
    </figure>
    <nav class="toc" aria-label={toc.title}>
      <span class="spec">{toc.title}</span>
      <ul role="list">
        {toc.items.map((t: any) => <li><a href={t.href.replace('/Procurement', '')}>{t.label}</a></li>)}
      </ul>
    </nav>
  </PageHero>

  <!-- Contracts: one row per vehicle, logo to verify link -->
  <section class="section" id="contracts" aria-labelledby="ct-title">
    <div class="wrap">
      <div class="split">
        <h2 id="ct-title" class="h2" data-reveal>{ct.heading}</h2>
        <div class="split-body" data-reveal>{ct.body.map((p: string, i: number) => <p class:list={[i === 0 ? 'lede' : 'body']}>{p}</p>)}</div>
      </div>
      <ul class="ctr" role="list">
        {ct.cards.map((c: any) => (
          <li data-reveal>
            <div class="ctr-logo">
              <img class="lg-l" src={asset(c.image.src)} alt={c.image.alt} loading="lazy" />
              <img class="lg-d" src={asset(c.image.darkSrc)} alt="" aria-hidden="true" loading="lazy" />
            </div>
            <div class="ctr-id">
              <h3 class="ctr-t">{c.title}</h3>
              <p class="spec">{c.meta}</p>
            </div>
            <div class="ctr-body">
              <p class="small">{c.body}</p>
              {c.tags && <ul class="tags" role="list" aria-label={c.tagsAriaLabel}>{c.tags.map((t: string) => <li>{t}</li>)}</ul>}
            </div>
            {c.links.map((l: any) => (
              <a class="verify" href={l.href} target={l.target} rel="noopener">
                <span class="v-l">{l.label}</span>
                <span class="spec">{strip(l.host)} <Icon name="arrow-up-right" size={12} /></span>
                <span class="sr-only">{l.srText}</span>
              </a>
            ))}
          </li>
        ))}
      </ul>
      <div class="row-ctas" data-reveal>
        <p class="small">{ct.afterBody[0]}</p>
        <div class="btns">
          {ct.ctas.map((c: any) => (
            <a class:list={['btn', c.style === 'ink' ? 'btn-primary' : 'btn-ghost']} href={c.href.replace('/Procurement', '')}>{c.label}{c.style === 'ink' && <Icon name="arrow-right" />}</a>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Purchasing office: the IDs and certifications, ready to copy -->
  <section class="section" id="office" aria-labelledby="office-title">
    <div class="wrap office">
      <div class="office-head">
        <h2 id="office-title" class="h2" data-reveal>{office.heading}</h2>
        <p class="lede" data-reveal>{office.lede}</p>
        <div class="certs" data-reveal>
          <h3 class="f-title">{office.lists[0].title}</h3>
          <ul class="tags" role="list">{office.lists[0].items.map((t: string) => <li>{t}</li>)}</ul>
        </div>
      </div>
      <div data-reveal>
        <IdSheet ids={office.stats} copy={office.interactive.buttonLabel} copied={office.interactive.buttonLabelCopied} />
      </div>
    </div>
  </section>

  <!-- Grants: Alvin College's lab, tinted in Alvin's colours -->
  <section class="grants" id="grants" aria-labelledby="grants-title" style={`--ca:${gc.a};--cb:${gc.b};--cd:${gc.deep}`}>
    <img class="grants-bg" src={asset(gImg.src)} alt={gImg.alt} loading="lazy" decoding="async" />
    <div class="wrap grants-inner">
      <div class="g-card" data-reveal>
        <h2 id="grants-title" class="h2">{gh.title} <strong>{gh.strong}</strong></h2>
        <p class="body">{grants.body[0]}</p>
        <dl class="g-list">
          {grants.cards.map((c: any) => (<div><dt>{c.title}</dt><dd>{c.body}</dd></div>))}
        </dl>
        <a class="btn btn-primary" href={askCta.href}>{askCta.label} <Icon name="arrow-right" /></a>
      </div>
      <a class="label-glass pictured" href={picturedCta.href}><span class="dots" aria-hidden="true"><i></i><i></i></span>{picturedCta.label}</a>
    </div>
  </section>

  <!-- Leasing: pick a term, see what stays fixed -->
  <section class="section" id="leasing" aria-labelledby="lease-title">
    <div class="wrap lease">
      <div class="lease-head">
        <h2 id="lease-title" class="h2" data-reveal>{leasing.heading}</h2>
        <p class="lede" data-reveal>{leasing.body[0]}</p>
        <p class="small" data-reveal>{leasing.lede}</p>
        <fieldset class="term" data-reveal>
          <legend class="sr-only">{lease.ariaLabel}</legend>
          <div class="seg">
            {lease.options.map((o: string, i: number) => (
              <label><input type="radio" name="lease-term" value={o} checked={i === lease.defaultIndex} /><span>{o}</span></label>
            ))}
          </div>
          <p class="readout" aria-live="polite">
            {lease.options.map((o: string) => (
              <span class="ro" data-term={o}>
                <span class="ro-n num">{o.split(' ')[0]}</span><span class="ro-u">{o.split(' ').slice(1).join(' ')}</span>
                <span class="spec ro-note">{noteBase} {o}</span>
              </span>
            ))}
          </p>
        </fieldset>
      </div>
      <dl class="rows" data-reveal>
        {leasing.cards.map((c: any) => (<div><dt>{c.title}</dt><dd>{c.body}</dd></div>))}
      </dl>
    </div>
  </section>

  <!-- Questions -->
  <section class="section" id="questions" aria-labelledby="faq-title">
    <div class="wrap faq-grid">
      <div>
        <h2 id="faq-title" class="h2" data-reveal>{faq.heading}</h2>
        <a class="assess-card" href={assess.links[0].href} data-reveal>
          <strong>{assess.title}</strong>
          <span class="small">{assess.body}</span>
          <span class="btn btn-primary btn-sm">{assess.links[0].label} <Icon name="arrow-right" /></span>
        </a>
      </div>
      <Faq items={faq.faqs} name="faq-procurement" />
    </div>
  </section>

  <ProjectCTA />
</Base>

<style>
  .lg-d { display: none; }
  :global([data-theme='dark']) .lg-l { display: none; }
  :global([data-theme='dark']) .lg-d { display: block; }
  .btns { display: flex; flex-wrap: wrap; gap: .75rem; }
  .f-title { font-size: 1.0625rem; font-weight: 640; letter-spacing: -0.01em; margin-bottom: .85rem; }
  .tags { list-style: none; padding: 0; display: flex; flex-wrap: wrap; gap: .4rem; }
  .tags li { font-size: .8125rem; font-weight: 560; padding: .28rem .7rem; border-radius: 999px; background: var(--surface); border: 1px solid var(--line); color: var(--ink-2); }
  .dots { display: inline-flex; }
  .dots i { width: .7rem; height: .7rem; border-radius: 50%; background: var(--ca); box-shadow: 0 0 0 2px var(--glass-hi); }
  .dots i + i { background: var(--cb); margin-left: -.2rem; }

  /* Hero figure + on-this-page */
  .h-fig { position: relative; width: min(1180px, 92vw); margin: clamp(2.5rem, 5vw, 4rem) auto 0; }
  .plate { aspect-ratio: 21 / 9; position: relative; }
  .plate::before { content: ''; position: absolute; left: 0; right: 0; top: 0; height: 6px; z-index: 1; background: linear-gradient(90deg, var(--ca), var(--cb)); }
  .chip { position: absolute; left: 1.25rem; bottom: 1.25rem; padding-left: .8rem; text-decoration: none; font-size: .875rem; }
  .chip:hover { background: var(--glass-hi); }
  @media (prefers-reduced-motion: no-preference) {
    .h-fig { animation: rise 1.4s var(--ease-out) both .1s; }
  }
  @keyframes rise { from { opacity: 0; transform: translateY(32px) scale(.98); filter: blur(6px); } }
  .toc { width: min(100% - 2 * var(--gutter), var(--max)); margin: clamp(2rem, 4vw, 3rem) auto 0; display: flex; flex-wrap: wrap; align-items: center; justify-content: center; gap: .75rem 1.25rem; padding-top: 1.5rem; border-top: 1px solid var(--line); }
  .toc ul { list-style: none; padding: 0; display: flex; flex-wrap: wrap; justify-content: center; gap: .4rem; }
  .toc a { display: block; padding: .45rem .95rem; border-radius: 999px; border: 1px solid var(--line-2); font-size: .9375rem; font-weight: 600; text-decoration: none; color: var(--ink-2); transition: color .25s, border-color .25s, background-color .25s; }
  .toc a:hover { color: var(--ink); border-color: var(--ink-3); background: var(--surface); }

  /* Contracts */
  .split { display: grid; grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr); gap: 1.5rem 4rem; align-items: end; margin-bottom: clamp(2.5rem, 4vw, 3.5rem); }
  .split-body { display: grid; gap: 1rem; }
  .ctr { list-style: none; padding: 0; margin: 0; border-top: 1px solid var(--line-2); }
  .ctr > li { display: grid; grid-template-columns: 11rem minmax(0, 1fr) minmax(0, 1.25fr) 11rem; gap: 1.5rem clamp(1.5rem, 3vw, 2.5rem); align-items: center; padding: 1.75rem 0; border-bottom: 1px solid var(--line); }
  .ctr-logo { height: 52px; display: flex; align-items: center; }
  .ctr-logo img { height: 100%; width: auto; max-width: 150px; object-fit: contain; }
  .ctr-id { display: grid; gap: .4rem; }
  .ctr-t { font-size: 1.1875rem; font-weight: 640; letter-spacing: -0.015em; line-height: 1.25; }
  .ctr-body { display: grid; gap: .75rem; }
  .verify { justify-self: stretch; display: grid; gap: .2rem; text-align: right; text-decoration: none; padding: .7rem 1rem; border-radius: 16px; border: 1px solid var(--line-2); transition: border-color .25s, background-color .25s; }
  .verify:hover { border-color: var(--ink-3); background: var(--surface); }
  .v-l { font-weight: 620; font-size: .9375rem; color: var(--accent); }
  .verify .spec { display: inline-flex; align-items: center; justify-content: flex-end; gap: .25rem; text-transform: none; letter-spacing: .02em; }
  .row-ctas { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 1rem 2rem; margin-top: clamp(2rem, 3.5vw, 3rem); }
  .row-ctas .small { max-width: 52ch; }

  /* Office */
  .office { display: grid; grid-template-columns: minmax(0, .9fr) minmax(0, 1.1fr); gap: clamp(2.5rem, 6vw, 6rem); align-items: start; }
  .office-head { display: grid; gap: 1.25rem; position: sticky; top: 7rem; }
  .certs { margin-top: 1rem; padding-top: 1.5rem; border-top: 1px solid var(--line); }

  /* Grants (fixed light-on-photo colours, tinted by the client) */
  .grants { position: relative; min-height: min(100vh, 940px); display: grid; align-items: center; overflow: hidden; isolation: isolate; color: #F2F3F5; scroll-margin-top: 0; }
  .grants-bg { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; z-index: -2; }
  .grants::after { content: ''; position: absolute; inset: 0; z-index: -1; background: linear-gradient(90deg, rgba(var(--cd), .9) 0%, rgba(var(--cd), .55) 55%, rgba(10,11,14,.2) 100%); }
  .grants::before { content: ''; position: absolute; left: 0; right: 0; top: 0; height: 6px; background: linear-gradient(90deg, var(--ca), var(--cb)); }
  .grants-inner { position: relative; padding-block: clamp(4.5rem, 8vw, 7rem); }
  .g-card {
    max-width: 700px; display: grid; gap: 1.25rem; justify-items: start; padding: clamp(1.5rem, 3vw, 2.5rem); border-radius: 28px;
    background: rgba(18, 19, 24, .5); border: 1px solid rgba(255, 255, 255, .14);
    backdrop-filter: blur(24px) saturate(1.4); -webkit-backdrop-filter: blur(24px) saturate(1.4);
  }
  .g-card .body { color: #D5D8DE; }
  .g-list { width: 100%; border-top: 1px solid rgba(255,255,255,.16); }
  .g-list div { display: grid; grid-template-columns: minmax(0, .85fr) minmax(0, 1.3fr); gap: 1.25rem; padding: 1rem 0; border-bottom: 1px solid rgba(255,255,255,.12); }
  .g-list dt { font-weight: 640; }
  .g-list dd { font-size: var(--t-small); color: #C9CCD4; }
  .grants .btn-primary { background: #F2F3F5; color: #0E1016; }
  .pictured { position: absolute; right: 0; bottom: clamp(1.5rem, 3vw, 2.5rem); padding-left: .8rem; text-decoration: none; color: #F2F3F5; background: rgba(18, 19, 24, .5); border-color: rgba(255, 255, 255, .16); font-size: .8125rem; }
  .pictured .dots i { box-shadow: 0 0 0 2px rgba(18, 19, 24, .8); }
  .pictured:hover { background: rgba(18, 19, 24, .75); }

  /* Leasing */
  .lease { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: clamp(2.5rem, 6vw, 6rem); align-items: start; }
  .lease-head { display: grid; gap: 1.25rem; justify-items: start; }
  .term { border: 0; padding: 1.25rem; margin: .75rem 0 0; width: 100%; border-radius: 24px; background: var(--surface); border: 1px solid var(--line); box-shadow: var(--shadow-float); display: grid; gap: 1.25rem; }
  .seg { display: grid; grid-template-columns: repeat(3, 1fr); padding: .3rem; border-radius: 999px; background: var(--surface-2); border: 1px solid var(--line); }
  .seg label { position: relative; cursor: pointer; }
  .seg input { position: absolute; inset: 0; opacity: 0; margin: 0; cursor: pointer; }
  .seg span { display: block; text-align: center; padding: .55rem .5rem; border-radius: 999px; font-size: .9375rem; font-weight: 600; color: var(--ink-2); transition: background-color .25s, color .25s; }
  .seg input:checked + span { background: var(--ink); color: var(--on-ink); }
  .seg input:focus-visible + span { outline: 2px solid var(--accent); outline-offset: 2px; }
  .readout { padding: .25rem .5rem .5rem; }
  .ro { display: none; align-items: baseline; flex-wrap: wrap; gap: .25rem .6rem; }
  .ro-n { font-size: clamp(3.5rem, 2.5rem + 3vw, 5rem); font-weight: 300; letter-spacing: -0.05em; line-height: 1; }
  .ro-u { font-size: 1.25rem; font-weight: 560; }
  .ro-note { flex-basis: 100%; margin-top: .5rem; }
  .term:has(input[value='12 months']:checked) .ro[data-term='12 months'],
  .term:has(input[value='24 months']:checked) .ro[data-term='24 months'],
  .term:has(input[value='36 months']:checked) .ro[data-term='36 months'] { display: flex; }
  .rows { display: grid; border-top: 1px solid var(--line-2); }
  .rows div { display: grid; gap: .35rem; padding: 1.4rem 0; border-bottom: 1px solid var(--line); }
  .rows dt { font-weight: 640; font-size: 1.125rem; letter-spacing: -0.01em; }
  .rows dd { color: var(--ink-2); }

  /* Questions */
  .faq-grid { display: grid; grid-template-columns: minmax(0, .8fr) minmax(0, 1.2fr); gap: clamp(2.5rem, 6vw, 6rem); align-items: start; }
  .assess-card { margin-top: 2rem; display: grid; gap: .6rem; justify-items: start; padding: 1.5rem; border-radius: 24px; background: var(--surface); border: 1px solid var(--line); text-decoration: none; box-shadow: var(--shadow-float); }
  .assess-card strong { font-size: 1.125rem; font-weight: 660; }
  .assess-card .btn { margin-top: .5rem; }

  @media (max-width: 1100px) {
    .ctr > li { grid-template-columns: 9rem minmax(0, 1fr) minmax(0, 1.2fr); }
    .verify { grid-column: 2 / -1; justify-self: start; text-align: left; }
    .verify .spec { justify-content: flex-start; }
  }
  @media (max-width: 960px) {
    .split, .office, .lease, .faq-grid { grid-template-columns: 1fr; }
    .office-head { position: static; }
  }
  @media (max-width: 760px) {
    .plate { aspect-ratio: 4 / 3; }
    .chip { left: .75rem; bottom: .75rem; font-size: .75rem; white-space: normal; }
    .ctr > li { grid-template-columns: 1fr; gap: 1rem; }
    .verify { grid-column: auto; }
    .ctr-logo { height: 44px; }
    .g-list div { grid-template-columns: 1fr; gap: .3rem; }
    .pictured { position: static; margin-top: 1.25rem; white-space: normal; }
    .toc { justify-content: flex-start; }
    .toc ul { justify-content: flex-start; }
  }
</style>
