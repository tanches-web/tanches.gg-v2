    {
      "id": "page-header",
      "ariaLabelledby": "br-title",
      "heading": "The TANCHES.GG mark, ready to use.",
      "headingHtml": "The TANCHES.GG mark, <span class=\"tg-grad\">ready to use.</span>",
      "lede": "Official logos, colors, and type for partners, districts, press, and sponsors. Download what you need, then follow the guidelines below so the brand looks the same on screen and in print.",
      "ctas": [
        { "label": "Download Brand Kit", "href": "assets/brand-kit/tanches-gg-brand-kit.zip", "download": "tanches-gg-brand-kit.zip", "style": "primary", "meta": "ZIP · 11 logos · SVG + PNG · 2.1 MB" }
      ],
      "interactive": {
        "jumpNav": {
          "ariaLabel": "On this page",
          "items": [
            { "label": "Logos", "target": "#logos" },
            { "label": "Usage", "target": "#usage" },
