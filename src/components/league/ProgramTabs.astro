---
// Division tabs. Without JavaScript all three divisions render one after another; with it they
// become tabs (arrow keys, Home, End). #education / #community / #commercial select a tab and
// pre-select the pricing form's program type.
import Icon from '../Icon.astro';
interface Tab {
  key: string; label: string; who: string; image: { src: string; alt: string }; title: string; desc: string;
  format: { value: string; label: string }[]; points: { title: string; body: string }[];
  hostHeading: string; host: string; link: { label: string; href: string }; labLink: { label: string; href: string };
}
interface Props { tabs: Tab[]; label: string; defaultTab?: string }
const { tabs, label, defaultTab = tabs[0].key } = Astro.props;
const programFor: Record<string, string> = { education: 'K-12 Education', community: 'Community / Government', commercial: 'Commercial' };
---
<div class="ptabs" data-ptabs data-default={defaultTab}>
  <div class="tablist" role="tablist" aria-label={label} hidden>
    {tabs.map((t) => (
      <button type="button" role="tab" id={`lg-tab-${t.key}`} aria-controls={t.key} aria-selected={t.key === defaultTab ? 'true' : 'false'} tabindex={t.key === defaultTab ? 0 : -1} data-key={t.key} data-program={programFor[t.key]}>{t.label}</button>
    ))}
  </div>
  {tabs.map((t) => (
    <section class="panel" id={t.key} role="tabpanel" aria-labelledby={`lg-tab-${t.key}`} data-panel={t.key}>
      <div class="p-media">
        <figure class="p-img photo"><img src={'/' + t.image.src} alt={t.image.alt} loading="lazy" decoding="async" /></figure>
        <dl class="fmt">
          {t.format.map((f) => (<div><dt>{f.label}</dt><dd>{f.value}</dd></div>))}
        </dl>
      </div>
      <div class="p-copy">
        <p class="spec who">{t.who}</p>
        <h3 class="h3 p-title">{t.title}</h3>
        <p class="body">{t.desc}</p>
        <dl class="points">
          {t.points.map((p) => (<div><dt>{p.title}</dt><dd>{p.body}</dd></div>))}
        </dl>
        <div class="host">
          <Icon name="trophy" size={22} />
          <p><strong>{t.hostHeading}</strong><span>{t.host}</span></p>
        </div>
        <div class="p-links">
          <a class="link" href={t.link.href}>{t.link.label} <Icon name="arrow-right" /></a>
          <a class="lab" href={t.labLink.href}><span><strong>Need a lab first?</strong> {t.labLink.label.replace('Need a lab first? ', '')}</span><Icon name="arrow-right" /></a>
        </div>
      </div>
    </section>
  ))}
</div>

<style>
  .tablist { display: inline-flex; gap: .25rem; padding: .35rem; border-radius: 999px; background: var(--surface); border: 1px solid var(--line); box-shadow: var(--shadow-float); margin-bottom: clamp(2rem, 4vw, 3rem); max-width: 100%; overflow-x: auto; }
  .tablist[hidden] { display: none; }
  [role='tab'] { min-height: 2.75rem; padding: 0 1.25rem; border-radius: 999px; font-weight: 620; color: var(--ink-2); white-space: nowrap; transition: background-color .25s, color .25s; }
  [role='tab']:hover { color: var(--ink); }
  [role='tab'][aria-selected='true'] { background: var(--ink); color: var(--on-ink); }
  .panel { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: clamp(2rem, 5vw, 5rem); align-items: start; }
  .panel + .panel { margin-top: clamp(4rem, 7vw, 6rem); }
  .ptabs.is-tabs .panel + .panel { margin-top: 0; }
  .panel[hidden] { display: none; }
  .p-media { display: grid; gap: 1.25rem; position: sticky; top: 7rem; }
  .p-img { aspect-ratio: 4 / 3; }
  .fmt { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); border-top: 1px solid var(--line-2); }
  .fmt div { display: flex; flex-direction: column-reverse; justify-content: flex-end; gap: .3rem; padding: 1rem .75rem 0 0; }
  .fmt div + div { padding-left: .9rem; border-left: 1px solid var(--line); }
  .fmt dd { font-size: clamp(1.25rem, 1rem + .9vw, 1.75rem); font-weight: 420; letter-spacing: -0.03em; line-height: 1.05; }
  .fmt dt { color: var(--ink-2); font-size: .875rem; }
  .p-copy { display: grid; gap: 1.1rem; justify-items: start; }
  .who { line-height: 1.6; }
  .p-title { font-size: clamp(1.625rem, 1.2rem + 1.2vw, 2.25rem); letter-spacing: -0.03em; }
  .points { width: 100%; margin-top: .5rem; border-top: 1px solid var(--line-2); }
  .points div { display: grid; grid-template-columns: minmax(0, .8fr) minmax(0, 1.3fr); gap: 1.25rem; padding: 1rem 0; border-bottom: 1px solid var(--line); }
  .points dt { font-weight: 640; }
  .points dd { color: var(--ink-2); font-size: var(--t-small); }
  .host { display: flex; align-items: center; gap: .9rem; width: 100%; padding: 1rem 1.15rem; border-radius: 18px; background: var(--surface); border: 1px solid var(--line); }
  .host :global(svg) { flex: none; color: var(--accent); }
  .host p { display: grid; }
  .host strong { font-weight: 640; }
  .host span { color: var(--ink-2); font-size: var(--t-small); }
  .p-links { display: grid; gap: 1rem; width: 100%; margin-top: .25rem; }
  .lab { display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding: 1rem 1.15rem; border-radius: 18px; border: 1px solid var(--line-2); text-decoration: none; font-size: var(--t-small); color: var(--ink-2); transition: background-color .25s, border-color .25s; }
  .lab strong { color: var(--ink); font-weight: 640; }
  .lab:hover { background: var(--surface); border-color: var(--ink-3); }
  .lab :global(svg) { flex: none; transition: transform .35s var(--ease-out); }
  .lab:hover :global(svg) { transform: translateX(3px); }
  @media (max-width: 960px) {
    .panel { grid-template-columns: 1fr; }
    .p-media { position: static; }
  }
  @media (max-width: 560px) {
    .tablist { display: flex; width: 100%; }
    [role='tab'] { flex: 1; padding: 0 .5rem; font-size: .9375rem; }
    .points div { grid-template-columns: 1fr; gap: .3rem; }
    .fmt dd { font-size: 1.125rem; }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-ptabs]').forEach((root) => {
    const list = root.querySelector<HTMLElement>('[role="tablist"]')!;
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const panels = [...root.querySelectorAll<HTMLElement>('[data-panel]')];
    list.hidden = false;
    root.classList.add('is-tabs');
    const select = (key: string, focus = false) => {
      tabs.forEach((t) => {
        const on = t.dataset.key === key;
        t.setAttribute('aria-selected', String(on));
        t.tabIndex = on ? 0 : -1;
        if (on && focus) t.focus();
      });
      panels.forEach((p) => (p.hidden = p.dataset.panel !== key));
    };
    const preset = (key: string) => {
      const prog = tabs.find((t) => t.dataset.key === key)?.dataset.program;
      const sel = document.getElementById('lg-prog') as HTMLSelectElement | null;
      if (sel && prog) sel.value = prog;
    };
    tabs.forEach((t, i) => {
      t.addEventListener('click', () => select(t.dataset.key!));
      t.addEventListener('keydown', (e) => {
        const k = e.key;
        let n = -1;
        if (k === 'ArrowRight') n = (i + 1) % tabs.length;
        else if (k === 'ArrowLeft') n = (i - 1 + tabs.length) % tabs.length;
        else if (k === 'Home') n = 0;
        else if (k === 'End') n = tabs.length - 1;
        if (n >= 0) { e.preventDefault(); select(tabs[n].dataset.key!, true); }
      });
    });
    const fromHash = () => {
      const key = location.hash.slice(1);
      if (tabs.some((t) => t.dataset.key === key)) {
        select(key);
        preset(key);
        const target = document.getElementById('programs');
        if (target) setTimeout(() => target.scrollIntoView({ block: 'start' }), 350);
        return true;
      }
      return false;
    };
    if (!fromHash()) select(root.dataset.default!);
    addEventListener('hashchange', fromHash);
  });
</script>
