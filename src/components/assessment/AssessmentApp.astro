---
// Facility Readiness Assessment. Four screens on the sweep (path → intake → one question at a time → results).
// Copy is verbatim from src/content/pages/Assessment.json and src/content/forms.json → assessment.
import PageHero from '../PageHero.astro';
import SectionHead from '../SectionHead.astro';
import Icon from '../Icon.astro';
import page from '../../content/pages/Assessment.json';
import forms from '../../content/forms.json';

const sec = (id: string) => page.sections.find((s: any) => s.id === id) as any;
const hero = sec('as-hero');
const get = sec('as-get');
const intake = sec('as-intake');
const qsec = sec('as-question');
const res = sec('as-results-head');
const areas = sec('as-areas');
const plan = sec('as-plan');
const cta = sec('asm-cta');
const A = (forms as any).assessment;
const allForms = (forms as any).forms as any[];
const intakeForm = allForms.find((f) => f.id === 'assessment-intake');
const secretIds: string[] = allForms.find((f) => f.id === 'contact').fields[0].placeholderOptions;
const f = (id: string) => intakeForm.fields.find((x: any) => x.id === id);
const fields = ['as-name', 'as-email', 'as-org', 'as-phone'].map(f);

const order = ['education', 'community', 'commercial'];
const data = {
  paths: order.map((k) => A.paths.find((p: any) => p.key === k)),
  tracks: Object.fromEntries(order.map((k) => [k, [...A.tracks[k]].sort((a: any, b: any) => a.n - b.n).map(({ id, dim, w, text, strong, options, recs }: any) => ({ id, dim, w, text, strong, options, recs }))])),
  tiers: Object.fromEntries(Object.entries(A.tiers).map(([k, t]: any) => [k, { name: t.name, desc: t.desc }])),
  pad: A.padSteps,
  secretIds,
};
const json = JSON.stringify(data).replace(/</g, '\\u003c');
const icons: Record<string, string> = { education: 'graduation', community: 'landmark', commercial: 'building' };
const RC = A.resultsScreenCopy;
---
<div class="asm" data-asm>
  <p class="sr-only" aria-live="polite" id="asm-live"></p>

  <!-- 1 · Path: hero, track picker, what you get -->
  <div data-screen="path">
    <PageHero title="Is your organization" strong="ready to build?" lede={hero.lede}
      image={{ src: '/' + hero.images[0].src, alt: hero.images[0].alt, pos: 'center 62%' }}>
      <ul slot="after-copy" class="asm-facts" role="list">
        {hero.lists[0].items.map((t: string) => <li class="spec">{t}</li>)}
      </ul>
      <div class="asm-picker" role="group" aria-labelledby="as-paths-title">
        <h2 id="as-paths-title" class="asm-picker-h" tabindex="-1">{hero.interactive.heading}</h2>
        <ul class="asm-paths" role="list">
          {hero.interactive.paths.map((p: any) => (
            <li>
              <button type="button" class="asm-path" data-path={p.key}>
                <span class="asm-path-ic" aria-hidden="true"><Icon name={icons[p.key]} size={22} /></span>
                <span class="asm-path-t">{p.title}</span>
                <span class="asm-path-s">{p.sub}</span>
                <span class="asm-path-go">{p.go} <Icon name="arrow-right" size={16} /></span>
              </button>
            </li>
          ))}
        </ul>
        <noscript><p class="small asm-nojs">{page.seo.noscript.p[1]}</p></noscript>
      </div>
      <a class="asm-pictured" href={hero.pictured.href} aria-label={hero.pictured.ariaLabel}>
        <span class="asm-pictured-logo"><img src={'/' + hero.pictured.logo} alt="" width="28" height="28" /></span>
        <span class="spec">[ {hero.pictured.small} · {hero.pictured.text} ]</span>
        <Icon name="arrow-up-right" size={14} />
      </a>
    </PageHero>

    <section class="section asm-get" aria-labelledby="as-get-title">
      <div class="wrap">
        <SectionHead id="as-get-title" title="A report you can take" strong="to leadership." lede={get.lede} />
        <ol class="asm-getlist" role="list" data-reveal>
          {get.cards.map((c: any) => (
            <li><span class="spec num">{c.meta}</span><strong>{c.title}</strong><p class="small">{c.body}</p></li>
          ))}
        </ol>
        <div class="asm-after" data-reveal>
          <p>{get.body[0]}</p>
          <a class="btn btn-primary" href={get.ctas[0].href}>{get.ctas[0].label} <Icon name="arrow-right" /></a>
        </div>
      </div>
    </section>
  </div>

  <!-- 2 · Intake -->
  <section class="asm-stage sweep" data-screen="intake" hidden aria-labelledby="as-intake-title">
    <div class="asm-narrow">
      <div class="asm-bar">
        <button type="button" class="asm-back" data-act="to-paths"><Icon name="chevron-left" size={18} />{intake.barBack}</button>
        <span class="spec" data-intake-meta>Before you start</span>
      </div>
      <form class="asm-card" id="asm-intake" novalidate>
        <div class="asm-cardhead">
          <h1 id="as-intake-title" class="asm-qtext" tabindex="-1">{intake.heading}</h1>
          <p class="body">{intake.body[0]}</p>
        </div>
        <div class="asm-fields">
          {fields.map((x: any) => (
            <div class="asm-f">
              <label for={x.id}>{x.label}</label>
              <input id={x.id} name={x.name} type={x.type} autocomplete={x.autocomplete} required={x.required || undefined}
                placeholder={x.id === 'as-name' ? secretIds[0] : x.placeholder} aria-describedby={x.required ? 'asm-intake-err' : undefined} />
            </div>
          ))}
        </div>
        <p class="asm-err" id="asm-intake-err" role="alert" hidden></p>
        <button type="submit" class="btn btn-primary asm-full">{intake.ctas[0].label} <Icon name="arrow-right" /></button>
        <p class="asm-note">{intake.formNote}</p>
      </form>
    </div>
  </section>

  <!-- 3 · Questions, one at a time -->
  <section class="asm-stage sweep" data-screen="q" hidden aria-labelledby="as-q">
    <h1 class="sr-only">{qsec.srHeading}</h1>
    <div class="asm-narrow">
      <div class="asm-bar">
        <button type="button" class="asm-back" data-act="back"><Icon name="chevron-left" size={18} />{qsec.barBack}</button>
        <span class="spec num" data-step-label aria-hidden="true"></span>
      </div>
      <div class="asm-prog">
        <div class="asm-segs" role="progressbar" aria-label={qsec.progressAriaLabel} aria-valuemin="0" aria-valuemax="100" aria-valuenow="0" data-segs></div>
        <span class="spec" data-q-meta></span>
      </div>
      <form class="asm-card asm-qcard" id="asm-q" novalidate>
        <h2 id="as-q" class="asm-qtext" tabindex="-1"></h2>
        <div class="asm-opts" role="radiogroup" aria-labelledby="as-q" data-opts></div>
        <div class="asm-qfoot">
          <p class="small">{qsec.hint}</p>
          <button type="submit" class="btn btn-primary btn-sm" data-next disabled>Continue <Icon name="arrow-right" /></button>
        </div>
      </form>
    </div>
  </section>

  <!-- 4 · Results -->
  <div data-screen="res" hidden>
    <section class="asm-reshead sweep" aria-labelledby="as-tier">
      <div class="wrap asm-resgrid">
        <div class="asm-rescopy">
          <h1 id="as-tier" class="display" tabindex="-1"><span class="asm-soft">{RC.headingPrefix}</span> <strong data-r="tier"></strong></h1>
          <p class="lede" data-r="desc"></p>
          <p class="spec" data-r="track"></p>
        </div>
        <div class="asm-score">
          <span class="spec">{res.scoreCard.label}</span>
          <p class="asm-scorev"><span class="num" data-r="score"></span><small>{res.scoreCard.suffix}</small></p>
          <div class="asm-meter" aria-hidden="true"><i data-r="meter"></i><b style="left:35%"></b><b style="left:65%"></b></div>
          <div class="asm-scale">{res.scoreCard.scale.map((s: string, i: number) => <span data-tier={['foundation', 'growth', 'premier'][i]}>{s}</span>)}</div>
        </div>
      </div>
    </section>

    <section class="section tight asm-areas" aria-label={areas.ariaLabel}>
      <div class="wrap asm-two">
        <div>
          <h2 class="h3">{RC.areasHeading}</h2>
          <ul class="asm-dims" role="list" data-r="dims"></ul>
        </div>
        <div>
          <h2 class="h3">{RC.strengthsHeading}</h2>
          <ul class="asm-strengths" role="list" data-r="strengths"></ul>
          <p class="body asm-none" data-r="none" hidden>{RC.noStrengths}</p>
        </div>
      </div>
    </section>

    <section class="section asm-plan" aria-labelledby="as-plan-title">
      <div class="wrap">
        <div class="asm-planhead">
          <h2 id="as-plan-title" class="h2">{plan.heading}</h2>
          <p class="lede">{plan.lede}</p>
        </div>
        <ol class="asm-steps" role="list" data-r="plan"></ol>
        <div class="asm-eco">
          <h2 class="h3">{plan.cards[0].title}</h2>
          <p class="body">{plan.cards[0].body}</p>
        </div>
      </div>
    </section>

    <section class="asm-cta sweep" aria-labelledby="as-cta-title">
      <div class="wrap asm-ctagrid">
        <div class="asm-ctacopy">
          <h2 id="as-cta-title" class="h2">Turn this report into <strong>a plan</strong>, <span data-r="first">there</span>.</h2>
          <p class="lede">{cta.lede}</p>
          <div class="asm-actions">
            <a class="btn btn-primary" href="/Contact" data-r="book">{cta.ctas[0].label} <Icon name="arrow-right" /></a>
            <button type="button" class="btn btn-ghost" data-act="pdf"><Icon name="download" /><span data-pdf-label>{cta.ctas[1].label}</span></button>
            <button type="button" class="asm-retake" data-act="retake">{cta.ctas[2].label}</button>
          </div>
          <div class="asm-ctafoot">
            <a class="link" href={cta.ctas[3].href}>{cta.ctas[3].label}</a>
            <span class="spec">Your report reference · <b class="num" data-r="ref"></b></span>
          </div>
        </div>
        <figure class="photo asm-ctaphoto"><img src={'/' + cta.images[0].src} alt="" loading="lazy" decoding="async" /></figure>
      </div>
    </section>
  </div>

  <!-- Templates cloned by the script -->
  <template id="asm-tpl-opt">
    <label class="asm-opt"><input type="radio" name="asm-opt" class="asm-radio" /><span class="asm-key" aria-hidden="true"></span><span class="asm-optl"></span><span class="asm-tick" aria-hidden="true"><Icon name="check" size={16} /></span></label>
  </template>
  <template id="asm-tpl-strength"><li><span class="asm-chk" aria-hidden="true"><Icon name="check" size={16} /></span><span class="asm-strt"></span><span class="spec"></span></li></template>

  <script type="application/json" id="asm-data" set:html={json}></script>
</div>

<!-- Netlify registers forms from static HTML: every field the script posts, plus the PDF attachment. -->
<form name="assessment" data-netlify="true" netlify-honeypot="bot-field" enctype="multipart/form-data" hidden aria-hidden="true">
  <input type="hidden" name="form-name" value="assessment" />
  <input name="bot-field" /><input name="name" /><input name="email" /><input name="organization" /><input name="phone" />
  <input name="subject" /><input name="page" /><textarea name="details"></textarea><input type="file" name="report" />
</form>

<script>
  import './app';
</script>

<style is:global>
  /* Path screen */
  .asm-facts { list-style: none; padding: 0; display: flex; flex-wrap: wrap; justify-content: center; gap: .5rem; margin-top: .25rem; }
  .asm-facts li { padding: .4rem .8rem; border-radius: 999px; border: 1px solid var(--line-2); background: var(--glass); color: var(--ink-2); }
  .asm-picker {
    position: relative; z-index: 2; width: min(1080px, calc(100% - 2 * var(--gutter))); margin: clamp(-6.5rem, -7vw, -2rem) auto 0;
    padding: clamp(1.25rem, 2.5vw, 2rem); border-radius: 28px;
    background: var(--glass); border: 1px solid var(--glass-line); box-shadow: var(--shadow-object);
    backdrop-filter: blur(22px) saturate(1.4); -webkit-backdrop-filter: blur(22px) saturate(1.4);
  }
  .asm-picker-h { font-size: var(--t-h3); font-weight: 560; letter-spacing: -0.02em; line-height: 1.2; text-align: center; margin-bottom: clamp(1rem, 2vw, 1.5rem); }
  .asm-picker-h:focus { outline: none; }
  .asm-paths { list-style: none; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .asm-paths > li + li { border-left: 1px solid var(--line); }
  .asm-path {
    width: 100%; height: 100%; display: grid; grid-template-columns: auto 1fr; grid-template-rows: auto 1fr auto; gap: .35rem .85rem; text-align: left;
    padding: 1.1rem 1.25rem; border-radius: 18px; transition: background-color .25s, transform .4s var(--ease-out);
  }
  .asm-path:hover { background: var(--surface); }
  .asm-path:active { transform: scale(.985); }
  .asm-path-ic { grid-row: span 3; width: 2.75rem; height: 2.75rem; border-radius: 14px; display: grid; place-items: center; background: var(--ink); color: var(--on-ink); }
  .asm-path-t { font-size: 1.25rem; font-weight: 660; letter-spacing: -0.015em; line-height: 1.2; }
  .asm-path-s { color: var(--ink-2); font-size: var(--t-small); line-height: 1.45; }
  .asm-path-go { display: inline-flex; align-items: center; gap: .4rem; margin-top: .5rem; color: var(--accent); font-weight: 600; font-size: .9375rem; }
  .asm-path-go svg { transition: transform .35s var(--ease-out); }
  .asm-path:hover .asm-path-go svg { transform: translateX(3px); }
  .asm-nojs { text-align: center; margin-top: 1rem; }
  .asm-pictured { display: flex; width: fit-content; max-width: calc(100% - 2 * var(--gutter)); align-items: center; gap: .6rem; margin: 1.25rem auto 0; text-decoration: none; color: var(--ink-3); }
  .asm-pictured:hover .spec { color: var(--ink); }
  .asm-pictured-logo { width: 1.75rem; height: 1.75rem; border-radius: 8px; overflow: hidden; background: var(--ink); display: grid; place-items: center; }
  .asm-pictured-logo img { width: 100%; height: 100%; object-fit: contain; padding: 3px; }

  .asm-getlist { list-style: none; padding: 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); border-top: 1px solid var(--line-2); }
  .asm-getlist li { display: grid; gap: .5rem; align-content: start; padding: 1.5rem clamp(1rem, 2vw, 1.75rem) 0; }
  .asm-getlist li:first-child { padding-left: 0; }
  .asm-getlist li + li { border-left: 1px solid var(--line); }
  .asm-getlist strong { font-size: 1.125rem; font-weight: 660; letter-spacing: -0.01em; }
  .asm-after { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 1rem 2rem; margin-top: clamp(2.5rem, 4vw, 3.5rem); padding-top: 1.75rem; border-top: 1px solid var(--line); }
  .asm-after p { color: var(--ink-2); }

  /* Stage: intake and questions */
  .asm-stage { padding: clamp(7.5rem, 5rem + 5vw, 9.5rem) 0 clamp(4rem, 8vw, 7rem); min-height: 100svh; }
  .asm-narrow { width: min(100% - 2 * var(--gutter), 760px); margin-inline: auto; }
  .asm-bar { display: flex; align-items: center; justify-content: space-between; gap: 1rem; margin-bottom: 1.25rem; }
  .asm-back { display: inline-flex; align-items: center; gap: .3rem; font-size: .9375rem; font-weight: 600; color: var(--ink-2); padding: .5rem .9rem .5rem .6rem; min-height: 2.75rem; border-radius: 999px; border: 1px solid var(--line-2); background: var(--glass); transition: color .2s, border-color .2s; }
  .asm-back:hover { color: var(--ink); border-color: var(--ink-3); }
  .asm-card { padding: clamp(1.5rem, 3.5vw, 2.75rem); border-radius: 28px; background: var(--surface); border: 1px solid var(--line); box-shadow: var(--shadow-object); }
  .asm-cardhead { display: grid; gap: .75rem; margin-bottom: 1.75rem; }
  .asm-qtext { font-size: clamp(1.75rem, 1.2rem + 2vw, 2.625rem); font-weight: 400; letter-spacing: -0.03em; line-height: 1.12; }
  .asm-qtext:focus { outline: none; }
  .asm-qtext:focus-visible { outline: 2px solid var(--accent); outline-offset: 6px; }

  .asm-fields { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.1rem 1rem; }
  .asm-f { display: grid; gap: .45rem; }
  .asm-f label { font-size: .875rem; font-weight: 600; }
  .asm-f input {
    width: 100%; min-height: 3rem; padding: .75rem .95rem; border-radius: 14px; font-size: 1rem;
    background: var(--bg); border: 1px solid var(--line-2); color: var(--ink); transition: border-color .2s, box-shadow .2s, background-color .2s;
  }
  .asm-f input::placeholder { color: var(--ink-3); opacity: 1; }
  .asm-f input:hover { border-color: var(--ink-3); }
  .asm-f input:focus { outline: none; border-color: var(--accent); box-shadow: 0 0 0 4px color-mix(in srgb, var(--accent) 18%, transparent); background: var(--surface); }
  .asm-f input[aria-invalid='true'] { border-color: #C2261B; }
  .asm-err { margin-top: 1rem; padding: .9rem 1rem; border-radius: 14px; background: color-mix(in srgb, #C2261B 10%, var(--surface)); border: 1px solid color-mix(in srgb, #C2261B 40%, transparent); font-size: var(--t-small); }
  .asm-err[hidden] { display: none; }
  .asm-full { width: 100%; margin-top: 1.5rem; }
  .asm-note { margin-top: .9rem; font-size: .8125rem; color: var(--ink-3); text-align: center; }

  .asm-prog { display: grid; gap: .65rem; margin-bottom: 1.25rem; }
  .asm-segs { display: grid; grid-auto-flow: column; grid-auto-columns: 1fr; gap: 6px; }
  .asm-segs i { height: 6px; border-radius: 99px; background: var(--line-2); position: relative; overflow: hidden; }
  .asm-segs i::after { content: ''; position: absolute; inset: 0; border-radius: inherit; background: var(--ink); transform-origin: left; transform: scaleX(0); transition: transform .5s var(--ease-out); }
  .asm-segs i.is-done::after { transform: none; }
  .asm-segs i.is-on::after { transform: none; background: var(--spectrum); }
  .asm-segs i.is-on.is-pending::after { transform: scaleX(.18); }

  .asm-opts { display: grid; gap: .65rem; margin-top: 1.75rem; }
  .asm-opt {
    position: relative; display: grid; grid-template-columns: auto 1fr auto; align-items: center; gap: 1rem;
    padding: 1rem 1.1rem; min-height: 3.75rem; border-radius: 16px; cursor: pointer;
    border: 1px solid var(--line-2); background: transparent; transition: border-color .2s, background-color .2s, transform .3s var(--ease-out);
  }
  .asm-opt:hover { border-color: var(--ink-3); background: var(--bg); }
  .asm-opt:active { transform: scale(.99); }
  .asm-radio { position: absolute; opacity: 0; width: 1px; height: 1px; margin: 0; pointer-events: none; }
  .asm-opt:has(.asm-radio:focus-visible) { outline: 2px solid var(--accent); outline-offset: 3px; }
  .asm-key { width: 2rem; height: 2rem; border-radius: 9px; display: grid; place-items: center; font: 500 .8125rem var(--mono); background: var(--surface-2); color: var(--ink-2); transition: background-color .2s, color .2s; }
  .asm-optl { font-weight: 560; line-height: 1.4; }
  .asm-tick { width: 1.75rem; height: 1.75rem; border-radius: 50%; display: grid; place-items: center; border: 1px solid var(--line-2); color: transparent; transition: background-color .2s, color .2s, border-color .2s; }
  .asm-opt:has(.asm-radio:checked) { border-color: var(--ink); background: var(--surface-2); }
  .asm-opt:has(.asm-radio:checked) .asm-key { background: var(--ink); color: var(--on-ink); }
  .asm-opt:has(.asm-radio:checked) .asm-tick { background: var(--ink); border-color: var(--ink); color: var(--on-ink); }
  .asm-qfoot { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 1rem; margin-top: 1.5rem; }
  .asm-qfoot .small { color: var(--ink-3); }
  .asm-qfoot .btn[disabled] { opacity: .4; pointer-events: none; box-shadow: none; }
  @media (prefers-reduced-motion: no-preference) {
    .asm-qcard.is-enter { animation: asm-in .55s var(--ease-out) both; }
    [data-screen].is-enter { animation: asm-fade .6s var(--ease-out) both; }
  }
  @keyframes asm-in { from { opacity: 0; transform: translateY(14px); } }
  @keyframes asm-fade { from { opacity: 0; } }

  /* Results */
  .asm-reshead { padding: clamp(7.5rem, 5rem + 5vw, 10rem) 0 clamp(3rem, 6vw, 5rem); }
  .asm-resgrid { display: grid; grid-template-columns: minmax(0, 1.25fr) minmax(0, .85fr); gap: clamp(2rem, 5vw, 5rem); align-items: center; }
  .asm-rescopy { display: grid; gap: 1.25rem; justify-items: start; }
  .asm-rescopy h1 { max-width: 14ch; }
  .asm-rescopy h1:focus { outline: none; }
  .asm-rescopy h1 strong { font-weight: 720; display: block; }
  .asm-soft { color: var(--ink-2); font-weight: 300; }
  .asm-score { padding: clamp(1.5rem, 3vw, 2.25rem); border-radius: 28px; background: var(--surface); border: 1px solid var(--line); box-shadow: var(--shadow-object); display: grid; gap: 1rem; }
  .asm-scorev { display: flex; align-items: baseline; gap: .5rem; line-height: 1; }
  .asm-scorev .num { font-size: clamp(4.5rem, 3rem + 6vw, 7.5rem); font-weight: 720; letter-spacing: -0.05em; }
  .asm-scorev small { font: 500 1rem var(--mono); color: var(--ink-3); }
  .asm-meter { position: relative; height: 8px; border-radius: 99px; background: var(--surface-2); }
  .asm-meter i { position: absolute; inset: 0 auto 0 0; border-radius: inherit; background: var(--spectrum); width: 0; transition: width 1.2s var(--ease-out); }
  .asm-meter b { position: absolute; top: -4px; bottom: -4px; width: 2px; background: var(--surface); }
  .asm-scale { display: grid; grid-template-columns: 35fr 30fr 35fr; font-size: .8125rem; color: var(--ink-3); font-weight: 560; }
  .asm-scale span:nth-child(2) { text-align: center; }
  .asm-scale span:last-child { text-align: right; }
  .asm-scale .is-on { color: var(--ink); font-weight: 700; }

  .asm-two { display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr); gap: clamp(2.5rem, 6vw, 6rem); }
  .asm-two .h3 { margin-bottom: 1.25rem; }
  .asm-dims { list-style: none; padding: 0; border-top: 1px solid var(--line-2); }
