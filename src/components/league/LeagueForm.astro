---
// League pricing form (Netlify form "league"). Static HTML so Netlify registers it at deploy.
// Works as a plain POST without JavaScript (returns to /League?sent=1#pricing); with JavaScript
// it sends in place, folds the selects into "details", and falls back to a ready-made email.
import Icon from '../Icon.astro';
import forms from '../../content/forms.json';
const spec = (forms as any).forms.find((f: any) => f.id === 'league');
const field = (id: string) => spec.fields.find((f: any) => f.id === id);
const fName = field('lg-name'), fEmail = field('lg-email'), fOrg = field('lg-org'), fProg = field('lg-prog'), fTeams = field('lg-teams'), fMsg = field('lg-msg');
const ids: string[] = fName.placeholderOptions;
---
<form class="lform" name="league" method="POST" action="/League?sent=1#pricing" data-netlify="true" netlify-honeypot="bot-field" data-lform aria-labelledby="lg-form-title">
  <input type="hidden" name="form-name" value="league" />
  <input type="hidden" name="subject" value="League lead" data-subject />
  <input type="hidden" name="page" value="/League" data-page />
  <p class="hp" aria-hidden="true"><label>Leave this empty <input name="bot-field" tabindex="-1" autocomplete="off" /></label></p>

  <div class="fields">
    <div class="f">
      <label for="lg-name">{fName.label}</label>
      <input id="lg-name" name="name" type="text" autocomplete="name" required placeholder={ids[0]} data-ids={JSON.stringify(ids)} />
    </div>
    <div class="f">
      <label for="lg-email">{fEmail.label}</label>
      <input id="lg-email" name="email" type="email" autocomplete="email" required placeholder={fEmail.placeholder} />
    </div>
    <div class="f wide">
      <label for="lg-org">{fOrg.label}</label>
      <input id="lg-org" name="organization" type="text" autocomplete="organization" placeholder={fOrg.placeholder} />
    </div>
    <div class="f">
      <label for="lg-prog">{fProg.label}</label>
      <div class="sel">
        <select id="lg-prog" name="program">
          {fProg.options.map((o: any) => <option value={o.value} selected={o.value === ''}>{o.label}</option>)}
        </select>
        <Icon name="chevron-down" size={18} />
      </div>
    </div>
    <div class="f">
      <label for="lg-teams">{fTeams.label}</label>
      <div class="sel">
        <select id="lg-teams" name="teams">
          {fTeams.options.map((o: any) => <option value={o.value} selected={o.value === ''}>{o.label}</option>)}
        </select>
        <Icon name="chevron-down" size={18} />
      </div>
    </div>
    <div class="f wide">
      <label for="lg-msg">{fMsg.label}</label>
      <textarea id="lg-msg" name="details" rows={fMsg.rows} placeholder={fMsg.placeholder}></textarea>
    </div>
  </div>

  <div class="foot">
    <button class="btn btn-primary" type="submit"><span class="lbl">{spec.submitLabel}</span><Icon name="arrow-right" /></button>
    <p class="note">Prefer to talk? Call <a href={spec.noteLink}>(281) 826-2437</a></p>
  </div>
  <p class="err" role="alert" hidden></p>

  <div class="done" role="status" hidden tabindex="-1">
    <span class="chip"><span class="dot"></span>{spec.success.chip}</span>
    <p class="h3">{spec.success.heading}</p>
    <p class="small">{spec.success.body}</p>
  </div>
</form>

<style>
  .hp { position: absolute; left: -9999px; width: 1px; height: 1px; overflow: hidden; }
  .fields { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.1rem 1rem; }
  .f { display: grid; gap: .45rem; }
  .f.wide { grid-column: 1 / -1; }
  label { font-size: .875rem; font-weight: 600; }
  input, select, textarea {
    width: 100%; min-height: 3rem; padding: .75rem .95rem; border-radius: 14px; font-size: 1rem;
    background: var(--bg); border: 1px solid var(--line-2); color: var(--ink);
    transition: border-color .2s, box-shadow .2s, background-color .2s;
  }
  input::placeholder, textarea::placeholder { color: var(--ink-3); }
  textarea { resize: vertical; min-height: 6rem; line-height: 1.5; }
  input:hover, select:hover, textarea:hover { border-color: var(--ink-3); }
  input:focus, select:focus, textarea:focus { outline: none; border-color: var(--accent); box-shadow: 0 0 0 4px color-mix(in srgb, var(--accent) 18%, transparent); background: var(--surface); }
  input:user-invalid { border-color: #C2261B; }
  .sel { position: relative; }
  .sel select { appearance: none; padding-right: 2.5rem; cursor: pointer; }
  .sel option { color: var(--ink); }
  .sel :global(svg) { position: absolute; right: .9rem; top: 50%; translate: 0 -50%; pointer-events: none; color: var(--ink-3); }
  .foot { display: flex; flex-wrap: wrap; align-items: center; gap: 1rem 1.5rem; margin-top: 1.5rem; }
  .note { font-size: .875rem; color: var(--ink-2); }
  .note a { color: var(--accent); font-weight: 600; }
  .err { margin-top: 1rem; padding: .9rem 1rem; border-radius: 14px; background: color-mix(in srgb, #C2261B 10%, var(--surface)); border: 1px solid color-mix(in srgb, #C2261B 40%, transparent); font-size: var(--t-small); }
  .err :global(a) { color: var(--accent); font-weight: 600; }
  button[aria-busy='true'] { opacity: .7; pointer-events: none; }
  .done { display: grid; gap: .75rem; justify-items: start; padding: 1rem 0; }
  .done[hidden], .err[hidden] { display: none; }
  .done:focus { outline: none; }
  .chip { display: inline-flex; align-items: center; gap: .5rem; padding: .3rem .75rem; border-radius: 999px; border: 1px solid var(--line-2); font: 500 var(--t-spec) var(--mono); letter-spacing: .08em; text-transform: uppercase; }
  .chip .dot { width: .5rem; height: .5rem; border-radius: 50%; background: #1FA35B; }
  .lform.is-done .fields, .lform.is-done .foot { display: none; }
  @media (max-width: 560px) { .fields { grid-template-columns: 1fr; } }
</style>

<script>
  document.querySelectorAll<HTMLFormElement>('[data-lform]').forEach((form) => {
    const page = form.querySelector<HTMLInputElement>('[data-page]');
    if (page) page.value = location.pathname;
    const nameEl = form.querySelector<HTMLInputElement>('#lg-name')!;
    try { const ids = JSON.parse(nameEl.dataset.ids || '[]'); if (ids.length) nameEl.placeholder = ids[Math.floor(Math.random() * ids.length)]; } catch {}
    const btn = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
    const lbl = btn.querySelector('.lbl')!;
    const label = lbl.textContent;
    const err = form.querySelector<HTMLElement>('.err')!;
    const done = form.querySelector<HTMLElement>('.done')!;
    const showDone = () => { form.classList.add('is-done'); done.hidden = false; };
    if (/[?&]sent=1/.test(location.search)) showDone();
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!form.reportValidity()) return;
      err.hidden = true;
      btn.setAttribute('aria-busy', 'true');
      lbl.textContent = 'Sending…';
      const data = new FormData(form);
      const org = String(data.get('organization') || '').trim();
      data.set('subject', `League lead: ${data.get('name')}${org ? ' · ' + org : ''}`);
      const extra = [['program', 'Program type'], ['teams', 'Expected teams']].map(([k, l]) => (data.get(k) ? `${l}: ${data.get(k)}` : '')).filter(Boolean).join('\n');
      if (extra) data.set('details', `${extra}\n\n${data.get('details') ?? ''}`.trim());
      try {
        const r = await fetch('/', { method: 'POST', headers: { 'Content-Type': 'application/x-www-form-urlencoded' }, body: new URLSearchParams(data as any).toString() });
        if (!r.ok) throw new Error(String(r.status));
        const w = window as any;
        try { w.gtag?.('event', 'generate_lead', { form_name: 'league' }); w.fbq?.('track', 'Lead', { content_name: 'league' }); if (w.lintrk && w.TG_LI_LEAD) w.lintrk('track', { conversion_id: Number(w.TG_LI_LEAD) }); } catch {}
        showDone();
        done.focus();
      } catch {
        const lines = [...data.entries()].filter(([k]) => !['form-name', 'bot-field'].includes(k)).map(([k, v]) => `${k}: ${v}`).join('\n');
        const href = `mailto:contact@tanches.gg?subject=${encodeURIComponent(String(data.get('subject') || 'League lead'))}&body=${encodeURIComponent(lines.slice(0, 1800))}`;
        err.innerHTML = `Your message didn’t go through. Please email us at contact@tanches.gg or call (281) 826-2437. <a href="${href}">Email it instead</a>`;
        err.hidden = false;
      } finally {
        btn.removeAttribute('aria-busy');
        lbl.textContent = label;
      }
    });
  });
</script>
