---
import { SITE, FOOTER } from '../lib/site';
import Icon from './Icon.astro';
---
<footer class="footer">
  <div class="wrap">
    <div class="top">
      <div class="id">
        <a href="/" class="brand" aria-label="TANCHES.GG home">
          <img class="logo logo-light" src="/assets/brand-kit/tanches-gg-lockup-color-light.svg" alt="" width="190" height="45" loading="lazy" />
          <img class="logo logo-dark" src="/assets/brand-kit/tanches-gg-lockup-color-dark.svg" alt="" width="190" height="45" loading="lazy" />
        </a>
        <address>
          <a href={SITE.addressHref} target="_blank" rel="noopener">{SITE.address.street}, {SITE.address.city}, {SITE.address.region} {SITE.address.zip}</a><br />

          <a href={SITE.phoneHref}>{SITE.phone}</a> · <a href={`mailto:${SITE.email}`}>{SITE.email}</a>
        </address>
        <div class="social">
          <a class="soc" href={SITE.social.linkedin} rel="noopener" target="_blank"><Icon name="linkedin" size={18} /><span>LinkedIn</span></a>
          <a class="soc" href={SITE.social.instagram} rel="noopener" target="_blank"><Icon name="instagram" size={18} /><span>Instagram</span></a>
        </div>
      </div>
      <nav class="cols" aria-label="Footer">
        {FOOTER.map((col) => (
          <div>
            <h2 class="spec">{col.title}</h2>
            <ul role="list">{col.links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}</ul>
          </div>
        ))}
      </nav>
    </div>
    <p class="contracts spec"><span>Purchasing contracts</span>{SITE.contracts.map((c) => <span>{c}</span>)}</p>
    <div class="bottom">
      <p>{SITE.legal}</p>
    </div>
  </div>
  <div class="wordmark" aria-hidden="true">[TANCHES<span>.GG</span>]</div>
</footer>

<style>
  .footer { position: relative; overflow: hidden; padding-top: clamp(4rem, 3rem + 4vw, 7rem); border-top: 1px solid var(--line); background: var(--bg); }
  .top { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 2fr); gap: 3rem; }
  .logo { height: 2.5rem; width: auto; }
  .logo-dark { display: none; }
  :global([data-theme='dark']) .logo-light { display: none; }
  :global([data-theme='dark']) .logo-dark { display: block; }
  address { font-style: normal; color: var(--ink-2); margin-top: 1.5rem; line-height: 1.7; font-size: var(--t-small); }
  address a { text-decoration: none; }
  address a:hover { color: var(--ink); text-decoration: underline; }
  .social { display: flex; gap: .5rem; margin-top: 1.25rem; }
  .soc { display: inline-flex; align-items: center; gap: .45rem; height: 2.5rem; padding: 0 1rem; border-radius: 999px; border: 1px solid var(--line-2); text-decoration: none; font-size: .875rem; font-weight: 560; }
  .soc:hover { background: var(--line); }
  .cols { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 2rem; }
  .cols h2 { margin-bottom: 1rem; }
  .cols ul { list-style: none; padding: 0; display: grid; gap: .55rem; }
  .cols a { text-decoration: none; font-weight: 520; font-size: var(--t-small); }
  .cols a:hover { color: var(--accent); }
  .contracts { margin-top: 4rem; padding: 1.25rem 0; border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); display: flex; flex-wrap: wrap; gap: .5rem 1.75rem; }
  .contracts span:first-child { color: var(--ink); }
  .bottom { padding: 1.25rem 0 0; font-size: .8125rem; color: var(--ink-3); }
  .wordmark {
    font-weight: 800; font-variation-settings: 'wdth' 70; letter-spacing: -0.04em; line-height: .78;
    font-size: clamp(4rem, 15.5vw, 15rem); text-align: center; white-space: nowrap;
    color: transparent; -webkit-text-stroke: 1px var(--line-2); margin-top: 2.5rem; translate: 0 12%; user-select: none;
  }
  .wordmark span { -webkit-text-stroke: 0; background: var(--spectrum); -webkit-background-clip: text; background-clip: text; opacity: .9; }
  @media (max-width: 900px) {
    .top { grid-template-columns: 1fr; }
    .cols { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
</style>
