      "interactive": {
        "type": "case-study-card-grid",
        "cardMarkup": "Whole card is <a href>. Layers: photo, shade, colour wash, glass chip (meta), logo (alt=\"\" aria-hidden), h2 title, p desc, 'go' line = cta + arrow, bottom stripe. CSS vars --a, --b, --deep (rgb triplet from deep hex).",
        "filters": "none (no category filters on this page)"
      },
      "_source": {
        "href": "'/Project-' + w.id",
        "cta": "w.soon ? 'Case study coming soon' : 'Read the case study'",
        "--deep": "[1,3,5].map(k => parseInt(w.deep.slice(k,k+2),16)).join(',')",
        "computedButUnrendered": "cls ('is-feature'), logoCls ('is-tall'), imgF (w.soon ? 'saturate(0.6)' : 'none'), kind (w.soon ? 'Case study coming soon' : 'Built with'), partners: computed in renderVals but not bound in the template; hi, label, mascot, colors also unbound here"
      }
